rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isContentCreator() {
      return request.auth != null &&
             (request.auth.token.role == 'admin' ||
              request.auth.token.role == 'contentCreator');
    }

    // Users collection - users can read/write their own data, admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null;
    }

    // Questions collection - authenticated users can read, admins/content creators can write
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write, create, delete: if isContentCreator();
    }

    // Question attempts - users can read/write their own
    match /question_attempts/{attemptId} {
      allow read, write: if isOwner(resource.data.userId) || isAdmin();
    }

    // Question banks/categories - authenticated users can read, admins can manage
    match /question_banks/{bankId} {
      allow read: if isAuthenticated();
      allow write, create, delete: if isAdmin();
    }

    // User sessions - users can manage their own sessions
    match /user_sessions/{sessionId} {
      allow read, write: if isOwner(resource.data.userId) || isAdmin();
    }

    // Admin-only collections for analytics and system data
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Public collections (if any)
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // System collections for maintenance
    match /system/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}